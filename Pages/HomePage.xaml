<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.HomePage"
             Title="GPS Tracker">

    <!-- La barra de estado vive en la CABECERA (Shell.TitleView): icono de estado + datos en
         una linea + boton de centrar. Asi el mapa ocupa toda la pantalla. -->
    <Shell.TitleView>
        <!-- Todo en UNA fila: nombre de la app + lat/lon/estado + botón de centrar. -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4,4,4" ColumnSpacing="8">
            <!-- Nombre de la app -->
            <Label Grid.Column="0"
                   Text="Hiker"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnPrimary}"
                   VerticalOptions="Center" />

            <!-- Barra de estado: icono + Lat/Lon/precision/velocidad en la misma linea -->
            <Grid Grid.Column="1"
                  ColumnDefinitions="Auto,*" ColumnSpacing="6"
                  VerticalOptions="Center">
                <Image Grid.Column="0"
                       x:Name="stateIcon"
                       Source="ic_st_pause.png"
                       WidthRequest="15"
                       HeightRequest="15"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       x:Name="statusLabel"
                       TextColor="{StaticResource OnPrimary}"
                       FontSize="11"
                       Opacity="0.95"
                       VerticalOptions="Center"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
            </Grid>

            <!-- Boton de centrar en la ubicacion -->
            <Button Grid.Column="2"
                    x:Name="gpsButton"
                    ImageSource="location.png"
                    BackgroundColor="Transparent"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    VerticalOptions="Center"
                    Clicked="OnGpsButtonClicked" />
        </Grid>
    </Shell.TitleView>

    <Grid>
        <!-- Mapa a pantalla completa -->
        <WebView x:Name="mapWebView"
                 BackgroundColor="{StaticResource MapCanvasBackground}" />

        <!-- Grabacion de la ruta. La logica ya existia en el code-behind, pero se habia quedado
             sin ningun control en pantalla al pasar el mapa a pantalla completa: no habia forma
             de grabar (nota de autor del 2026-08-01). -->

        <!-- Parado: un solo boton de grabar, arriba a la derecha del mapa. ZIndex explicito:
             sin el, el WebView del mapa se queda con el toque y el boton no llega a pulsarse.

             El margen derecho deja libre la esquina: ahi viven los mandos de zoom del mapa
             (NavigationControl en 'top-right', dentro del WebView), y el boton se les ponia
             justo encima. -->
        <Button x:Name="recordButton"
                ZIndex="10"
                ImageSource="ic_st_rec.png"
                VerticalOptions="Start"
                HorizontalOptions="End"
                Margin="0,12,76,0"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Clicked="OnStartTrackingClicked" />

        <!-- Grabando: lo que se lleva grabado y el boton de parar. No llega hasta el borde
             derecho por lo mismo que el boton: los mandos de zoom del mapa estan en esa esquina y
             la barra los tapaba de lado a lado. -->
        <Border x:Name="recordBar"
                ZIndex="10"
                IsVisible="False"
                VerticalOptions="Start"
                Margin="12,12,76,0"
                Padding="14,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <BoxView Grid.Column="0"
                         WidthRequest="12"
                         HeightRequest="12"
                         CornerRadius="6"
                         VerticalOptions="Center"
                         Color="{StaticResource Danger}" />

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label x:Name="recordTitleLabel"
                           FontSize="14"
                           FontAttributes="Bold"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label x:Name="recordDetailLabel"
                           FontSize="12"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        x:Name="recordStopButton"
                        ImageSource="ic_stop.png"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        VerticalOptions="Center"
                        Clicked="OnStopTrackingClicked" />
            </Grid>
        </Border>

        <!-- Seguimiento de la ruta cargada. Solo aparece cuando hay una ruta en el mapa: dice a
             que distancia estas del trazado y cuanto te queda, y se pone en rojo si te sales. -->
        <Border x:Name="followBar"
                IsVisible="False"
                VerticalOptions="End"
                Margin="12,0,12,12"
                Padding="14,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <BoxView Grid.Column="0"
                         x:Name="followStateDot"
                         WidthRequest="12"
                         HeightRequest="12"
                         CornerRadius="6"
                         VerticalOptions="Center"
                         Color="{StaticResource Success}" />

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label x:Name="followTitleLabel"
                           FontSize="14"
                           FontAttributes="Bold"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label x:Name="followDetailLabel"
                           FontSize="12"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        x:Name="followStopButton"
                        ImageSource="ic_stop.png"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        VerticalOptions="Center"
                        Clicked="OnStopFollowingClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
