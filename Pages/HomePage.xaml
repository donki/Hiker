<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.HomePage"
             Title="GPS Tracker">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Panel de informacion GPS -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryDark}"
                StrokeThickness="0"
                Margin="10,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid Padding="12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label x:Name="locationLabel"
                           Text="Obteniendo ubicación..."
                           TextColor="{StaticResource White}"
                           FontSize="14" />
                    <Label x:Name="accuracyLabel"
                           Text="Precisión: --"
                           TextColor="#DDF3DD"
                           FontSize="12" />
                    <Label x:Name="speedLabel"
                           Text="Velocidad: -- km/h"
                           TextColor="#DDF3DD"
                           FontSize="12" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="gpsButton"
                        ImageSource="location.png"
                        BackgroundColor="{StaticResource Primary}"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25"
                        Padding="0"
                        Clicked="OnGpsButtonClicked" />
            </Grid>
        </Border>

        <!-- Mapa OpenStreetMap -->
        <WebView x:Name="mapWebView"
                 Grid.Row="1"
                 BackgroundColor="#1A1A1A" />

        <!-- Panel de controles -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource PrimaryDark}"
                StrokeThickness="0"
                Margin="10,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid Padding="8" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0"
                        x:Name="startTrackingButton"
                        Text="Iniciar"
                        ImageSource="ic_play.png"
                        ContentLayout="Top,4"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12"
                        Clicked="OnStartTrackingClicked" />

                <Button Grid.Column="1"
                        x:Name="stopTrackingButton"
                        Text="Parar"
                        ImageSource="ic_stop.png"
                        ContentLayout="Top,4"
                        Style="{StaticResource DangerButton}"
                        FontSize="12"
                        IsEnabled="False"
                        Clicked="OnStopTrackingClicked" />

                <Button Grid.Column="2"
                        x:Name="saveRouteButton"
                        Text="Guardar"
                        ImageSource="ic_save.png"
                        ContentLayout="Top,4"
                        Style="{StaticResource AccentButton}"
                        FontSize="12"
                        IsEnabled="False"
                        Clicked="OnSaveRouteClicked" />

                <Button Grid.Column="3"
                        x:Name="clearButton"
                        Text="Limpiar"
                        ImageSource="ic_trash.png"
                        ContentLayout="Top,4"
                        Style="{StaticResource OutlineButton}"
                        TextColor="{StaticResource White}"
                        BorderColor="{StaticResource White}"
                        FontSize="12"
                        Clicked="OnClearClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
