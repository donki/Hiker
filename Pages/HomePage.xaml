<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.HomePage"
             Title="GPS Tracker">

    <!-- La barra de estado vive en la CABECERA (Shell.TitleView): icono de estado + datos en
         una linea + boton de centrar. Asi el mapa ocupa toda la pantalla. -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,0,4,0" VerticalOptions="Fill">
            <Image Grid.Column="0"
                   x:Name="stateIcon"
                   Source="ic_st_pause.png"
                   WidthRequest="18"
                   HeightRequest="18"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   x:Name="statusLabel"
                   TextColor="{StaticResource OnPrimary}"
                   FontSize="13"
                   VerticalOptions="Center"
                   MaxLines="1"
                   LineBreakMode="TailTruncation" />

            <Button Grid.Column="2"
                    x:Name="gpsButton"
                    ImageSource="location.png"
                    BackgroundColor="Transparent"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    Clicked="OnGpsButtonClicked" />
        </Grid>
    </Shell.TitleView>

    <!-- Mapa a pantalla completa -->
    <WebView x:Name="mapWebView"
             BackgroundColor="{StaticResource MapCanvasBackground}" />
</ContentPage>
