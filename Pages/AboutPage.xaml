<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.AboutPage"
             Title="Acerca de">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Logo y titulo -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center">
                    <Image Source="splash.png" WidthRequest="100" HeightRequest="100" />

                    <Label Text="HIKER"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />

                    <Label Text="Tu compañero de aventuras"
                           Style="{StaticResource BodyText}"
                           HorizontalOptions="Center" />

                    <Label x:Name="versionLabel"
                           Text="Versión 1.9.326"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Caracteristicas -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Características" Style="{StaticResource CardTitle}" />
                    <Label Text="• GPS en tiempo real con alta precisión" Style="{StaticResource BodyText}" />
                    <Label Text="• Grabación y seguimiento de rutas" Style="{StaticResource BodyText}" />
                    <Label Text="• Mapas nativos integrados" Style="{StaticResource BodyText}" />
                    <Label Text="• Filtros GPS avanzados (Kalman)" Style="{StaticResource BodyText}" />
                    <Label Text="• Soporte para archivos GPX" Style="{StaticResource BodyText}" />
                    <Label Text="• Interfaz nativa optimizada" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Info tecnica -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Información Técnica" Style="{StaticResource CardTitle}" />
                    <Label Text="• Desarrollado con .NET 9 MAUI" Style="{StaticResource BodyText}" />
                    <Label Text="• Interfaz 100% nativa" Style="{StaticResource BodyText}" />
                    <Label Text="• Optimizado para Windows y Android" Style="{StaticResource BodyText}" />
                    <Label Text="• GPS de alta frecuencia (hasta 10Hz)" Style="{StaticResource BodyText}" />
                    <Label Text="• Gestión avanzada de memoria" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Info del sistema -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Información del Sistema" Style="{StaticResource CardTitle}" />
                    <Label x:Name="platformLabel" Text="Plataforma: --" Style="{StaticResource BodyText}" />
                    <Label x:Name="deviceLabel" Text="Dispositivo: --" Style="{StaticResource BodyText}" />
                    <Label x:Name="osVersionLabel" Text="Versión OS: --" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Acciones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="📧 Contacto"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnContactClicked" />

                <Button Grid.Column="1"
                        Text="⭐ Valorar"
                        Style="{StaticResource AccentButton}"
                        Clicked="OnRateClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
