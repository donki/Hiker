<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.AboutPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Cabecera: icono real de la app -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="24" Spacing="8">
                    <Image Source="app_logo.png"
                           WidthRequest="96"
                           HeightRequest="96"
                           HorizontalOptions="Center" />

                    <Label Text="Hiker"
                           Style="{StaticResource CardTitle}"
                           FontSize="26"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Center" />

                    <Label x:Name="VersionLabel" Text="{Binding Version}"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />

                    <Label x:Name="DescriptionLabel" IsVisible="False"
                           Style="{StaticResource HintText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />

                    <Label Text="Socratic"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Contacto -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20,18" Spacing="12">
                    <Label x:Name="ContactTitleLabel" Text="{Binding ContactTitle}" Style="{StaticResource CardTitle}" />

                    <Button Text="jsoladelarosa@gmail.com"
                            Style="{StaticResource OutlineButton}"
                            LineBreakMode="WordWrap"
                            Padding="12,10"
                            Clicked="OnContactClicked"
                            HorizontalOptions="Fill" />

                    <Label x:Name="ContactHintLabel" IsVisible="False"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20,18" Spacing="12">
                    <Label x:Name="LanguageTitleLabel" Text="{Binding LanguageTitle}" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="SpanishButton"
                                Text="🇪🇸 Español"
                                Style="{StaticResource OutlineButton}"
                                Clicked="OnSpanishClicked" />

                        <Button Grid.Column="1"
                                x:Name="EnglishButton"
                                Text="🇺🇸 English"
                                Style="{StaticResource OutlineButton}"
                                Clicked="OnEnglishClicked" />
                    </Grid>

                    <Label x:Name="LanguageHintLabel" Text="{Binding LanguageHint}"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Privacidad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20,18" Spacing="10">
                    <Label x:Name="PrivacyTitleLabel" Text="{Binding PrivacyTitle}" Style="{StaticResource CardTitle}" />
                    <Label x:Name="PrivacyTextLabel" Text="{Binding PrivacyText}" Style="{StaticResource BodyText}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Licencia -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20,18" Spacing="10">
                    <Label x:Name="LicenseTitleLabel" Text="{Binding LicenseTitle}" Style="{StaticResource CardTitle}" />
                    <Label x:Name="LicenseTextLabel" Text="{Binding LicenseText}" Style="{StaticResource BodyText}" FontSize="13" />
                    <Label Text="MIT License · Copyright © 2026 Socratic"
                           Style="{StaticResource HintText}"
                           FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- Aviso legal -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="20,18" Spacing="12">
                    <Label x:Name="LegalTitleLabel" Text="{Binding LegalTitle}"
                           Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Danger}" />

                    <Label x:Name="LegalText1Label" Text="{Binding LegalText1}" Style="{StaticResource BodyText}" FontSize="13" />
                    <Label x:Name="LegalText2Label" Text="{Binding LegalText2}" Style="{StaticResource BodyText}" FontSize="13" />

                    <Border BackgroundColor="{StaticResource Danger}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="LegalWarningLabel" Text="{Binding LegalWarning}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
