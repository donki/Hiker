<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.AboutPage"
             Title="Acerca de">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Cabecera: icono real de la app -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="30,25" Spacing="12">
                    <Image Source="app_logo.png"
                           WidthRequest="96"
                           HeightRequest="96"
                           HorizontalOptions="Center" />

                    <Label Text="Hiker"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Center" />

                    <Label x:Name="VersionLabel"
                           Style="{StaticResource HintText}"
                           FontSize="16"
                           HorizontalOptions="Center" />

                    <Label x:Name="DescriptionLabel"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Socratic"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Contacto -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="15">
                    <Label x:Name="ContactTitleLabel" Style="{StaticResource CardTitle}" />

                    <Button x:Name="ContactButton"
                            Text="jsoladelarosa@gmail.com"
                            Style="{StaticResource OutlineButton}"
                            LineBreakMode="WordWrap"
                            Padding="12,10"
                            Clicked="OnContactClicked"
                            HorizontalOptions="Fill" />

                    <Label x:Name="ContactInstructionLabel"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Apoyo (Ko-fi) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="15">
                    <Label x:Name="SupportTitleLabel"
                           Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Accent}" />

                    <Button x:Name="DonationButton"
                            Style="{StaticResource AccentButton}"
                            LineBreakMode="WordWrap"
                            Padding="12,10"
                            Clicked="OnDonationClicked"
                            HorizontalOptions="Fill" />

                    <Label x:Name="SupportDescLabel"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Aviso legal -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="15">
                    <Label x:Name="LegalTitleLabel"
                           Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Danger}" />

                    <Border StrokeThickness="0"
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="LegalTextLabel"
                                   Style="{StaticResource BodyText}"
                                   FontSize="13"
                                   LineHeight="1.4" />
                            <Label x:Name="LicenseLabel"
                                   Style="{StaticResource HintText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
