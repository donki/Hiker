<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.SettingsPage"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label x:Name="languageTitleLabel" Text="Idioma" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="spanishButton"
                                Text="🇪🇸 Español"
                                FontSize="14"
                                CornerRadius="10"
                                HeightRequest="46"
                                Clicked="OnSpanishClicked" />

                        <Button Grid.Column="1"
                                x:Name="englishButton"
                                Text="🇺🇸 English"
                                FontSize="14"
                                CornerRadius="10"
                                HeightRequest="46"
                                Clicked="OnEnglishClicked" />
                    </Grid>

                    <Label x:Name="languageHintLabel"
                           Text="Selecciona tu idioma preferido"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
