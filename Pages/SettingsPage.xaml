<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.SettingsPage"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- GPS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Configuración GPS" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Usar GPS Nativo" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="nativeGpsSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Intervalo de actualización (seg)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="intervalEntry" Text="1" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Precisión mínima (m)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="accuracyEntry" Text="10" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Filtros -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Filtros GPS" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtro Kalman" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="kalmanSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtro de velocidad" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="speedFilterSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Velocidad máxima (m/s)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="maxSpeedEntry" Text="50" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Idioma" Style="{StaticResource CardTitle}" />

                    <Picker x:Name="languagePicker"
                            Title="Seleccionar idioma"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                        <Picker.Items>
                            <x:String>Español</x:String>
                            <x:String>English</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Acciones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Name="saveButton"
                        Text="💾 Guardar"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked" />

                <Button Grid.Column="1"
                        x:Name="resetButton"
                        Text="🔄 Restablecer"
                        Style="{StaticResource DangerButton}"
                        Clicked="OnResetClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
