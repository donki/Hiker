<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.SettingsPage"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- GPS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Configuración GPS" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Usar GPS Nativo" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="nativeGpsSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Intervalo de actualización (seg)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="intervalEntry" Text="1" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Precisión mínima (m)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="accuracyEntry" Text="10" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Filtros GPS: ocultos a petición (los controles siguen en el árbol para el code-behind). -->
            <Border Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Filtros GPS" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtro Kalman" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="kalmanSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtro de velocidad" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="speedFilterSwitch" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,100">
                        <Label Grid.Column="0" Text="Velocidad máxima (m/s)" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                            <Entry x:Name="maxSpeedEntry" Text="50" Keyboard="Numeric" BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label x:Name="languageTitleLabel" Text="Idioma" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="spanishButton"
                                Text="🇪🇸 Español"
                                FontSize="14"
                                CornerRadius="10"
                                HeightRequest="46"
                                Clicked="OnSpanishClicked" />

                        <Button Grid.Column="1"
                                x:Name="englishButton"
                                Text="🇺🇸 English"
                                FontSize="14"
                                CornerRadius="10"
                                HeightRequest="46"
                                Clicked="OnEnglishClicked" />
                    </Grid>

                    <Label x:Name="languageHintLabel"
                           Text="Selecciona tu idioma preferido"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Acciones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Name="saveButton"
                        Text="Guardar"
                        ImageSource="ic_save.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked" />

                <Button Grid.Column="1"
                        x:Name="resetButton"
                        Text="Restablecer"
                        ImageSource="ic_refresh.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource DangerButton}"
                        Clicked="OnResetClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
