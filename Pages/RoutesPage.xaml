<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hiker.Pages.RoutesPage"
             Title="Rutas Guardadas">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryDark}"
                StrokeThickness="0"
                Margin="10,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Label Text="Gestión de Rutas"
                   TextColor="{StaticResource White}"
                   FontSize="18"
                   FontAttributes="Bold"
                   Padding="12"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Lista de rutas -->
        <CollectionView Grid.Row="1"
                        x:Name="routesCollectionView"
                        Margin="10"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="5">
                        <Grid Padding="14" ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource BodyText}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Distance, StringFormat='Distancia: {0:F2} km'}"
                                       Style="{StaticResource HintText}" />
                                <Label Text="{Binding CreatedDate, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                       Style="{StaticResource HintText}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="📍"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="0"
                                    Margin="5,0"
                                    Command="{Binding Source={x:Reference routesCollectionView}, Path=BindingContext.LoadRouteCommand}"
                                    CommandParameter="{Binding .}" />

                            <Button Grid.Column="2"
                                    Text="🗑️"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="{StaticResource White}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="0"
                                    Command="{Binding Source={x:Reference routesCollectionView}, Path=BindingContext.DeleteRouteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botones de accion -->
        <Grid Grid.Row="2" Margin="10,5" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    x:Name="loadGpxButton"
                    Text="📁 Cargar GPX"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnLoadGpxClicked" />

            <Button Grid.Column="1"
                    x:Name="refreshButton"
                    Text="🔄 Actualizar"
                    Style="{StaticResource AccentButton}"
                    Clicked="OnRefreshClicked" />
        </Grid>
    </Grid>
</ContentPage>
