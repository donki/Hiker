<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Marca: verde de Hiker (constitucion 24: color de marca propio, estructura comun). -->
    <Color x:Key="Primary">#4CAF50</Color>
    <Color x:Key="PrimaryDark">#2E7D32</Color>
    <Color x:Key="PrimaryLight">#81C784</Color>
    <Color x:Key="Accent">#FF9800</Color>
    <Color x:Key="Danger">#F44336</Color>
    <Color x:Key="Success">#27AE60</Color>

    <!-- Superficies -->
    <Color x:Key="PageBackgroundLight">#F5F7FA</Color>
    <Color x:Key="PageBackgroundDark">#12161B</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1C2229</Color>
    <Color x:Key="SeparatorLight">#E4E9EF</Color>
    <Color x:Key="SeparatorDark">#2A323C</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryLight">#1A1A1A</Color>
    <Color x:Key="TextPrimaryDark">#E8ECF1</Color>
    <Color x:Key="TextSecondaryLight">#6B7280</Color>
    <Color x:Key="TextSecondaryDark">#93A1B0</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Texto atenuado sobre el panel verde de marca (info GPS). -->
    <Color x:Key="TextOnPrimaryMuted">#DDF3DD</Color>
    <!-- Fondo del lienzo del mapa mientras carga el WebView. -->
    <Color x:Key="MapCanvasBackground">#1A1A1A</Color>

    <!-- Fondo del submenu GPS desplegable en el menu lateral. -->
    <Color x:Key="SubmenuBackgroundLight">#EEF3EE</Color>
    <Color x:Key="SubmenuBackgroundDark">#12211410</Color>

    <!-- Compatibilidad con estilos heredados que aun referencian estos nombres. -->
    <Color x:Key="Secondary">#FF9800</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnSecondary">#000000</Color>
    <Color x:Key="OnSurface">#1A1A1A</Color>

</ResourceDictionary>
