<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Hiker"
             x:Class="Hiker.MainPage"
             BackgroundColor="#1a1a1a">

    <Grid>
        <!-- Splash Screen mejorado -->
        <Grid x:Name="splashScreen" IsVisible="True" BackgroundColor="#1a1a1a">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E7D32" Offset="0.0" />
                    <GradientStop Color="#4CAF50" Offset="0.5" />
                    <GradientStop Color="#66BB6A" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="30">
                <Image Source="splash.png"
                       WidthRequest="120"
                       HeightRequest="120"
                       HorizontalOptions="Center">
                    <Image.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3" />
                    </Image.Shadow>
                </Image>
                
                <Label Text="HIKER"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center">
                    <Label.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.5" />
                    </Label.Shadow>
                </Label>
                
                <Label Text="Tu compañero de aventuras"
                       FontSize="16"
                       TextColor="#E8F5E8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Opacity="0.9" />
                
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <!-- BlazorWebView que se mostrará después del splash -->
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" IsVisible="False">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type local:Components.Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>
</ContentPage>
