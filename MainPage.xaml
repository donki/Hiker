<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Hiker"
             x:Class="Hiker.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">


    <Grid>
        <!-- Imagen que se muestra inicialmente -->
        <Image x:Name="splashImage" Source="splash.png"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="True" />

        <!-- BlazorWebView que se mostrará después de 5 segundos -->
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" IsVisible="False">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type local:Components.Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>
</ContentPage>
