@using System.Text
@inject IJSRuntime JS
@inject GeolocationService GeoService
@inject IFileSaver FileSaver
@inject IDialogService DialogService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="images/hikermenu.png" width="32" height="32" alt="Logo" style="margin-right: 8px;" /> Hiker
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink href="#" class="nav-link" @onclick="TriggerFileUpload">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Cargar Ruta
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="#" class="nav-link" @onclick="StartUpdatingPosition">

                <span style="display: inline-flex; align-items: center; line-height: 1;">
                    @if (ModoRuta)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="lime" class="bi bi-geo-alt-fill" viewBox="0 0 16 16" style="vertical-align: middle; margin-right: 4px;">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>

                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gray" class="bi bi-geo-alt-fill" viewBox="0 0 16 16" style="vertical-align: middle; margin-right: 4px;">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>

                    }
                    Modo Ruta
                </span>
            </NavLink>
            <InputFile id="gpxFileInput" OnChange="HandleFileSelected" style="display:none;" />
        </div>
        <div class="nav-item px-3">
            <NavLink href="#" class="nav-link" @onclick="ToggleRecordingMode">

                <span style="display: inline-flex; align-items: center; line-height: 1;">
                    @if (ModoGrabación)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 4px;">
                            <circle cx="256" cy="256" r="256" fill="red" />
                        </svg>

                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 4px;">
                            <circle cx="256" cy="256" r="256" fill="gray" />
                        </svg>

                    }
                    Modo Grabación
                </span>
            </NavLink>
            <InputFile id="gpxFileInput" OnChange="HandleFileSelected" style="display:none;" />
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about" Match="NavLinkMatch.All">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Acerca de...
            </NavLink>
        </div>



    </nav>
</div>

@code {

    private Timer? _timer;
    private bool ModoRuta = false;
    private bool ModoGrabación = false;
    private List<Location> recordedLocations = new();

    private async Task ToggleRecordingMode()
    {
        ModoGrabación = !ModoGrabación;

        if (ModoGrabación)
        {
            recordedLocations.Clear(); // Limpiar las grabaciones anteriores
            _timer = new Timer(async _ => await RecordLocationAsync(), null, 0, 5000);
            await JS.InvokeVoidAsync("requestWakeLock");
        }
        else
        {
            _timer?.Dispose();
            await PromptSaveRecording();
            await JS.InvokeVoidAsync("releaseWakeLock");
        }
    }

    private async Task RecordLocationAsync()
    {
        var location = await GeoService.GetCurrentLocationAsync();
        if (location != null)
        {
            recordedLocations.Add(location);
            await JS.InvokeVoidAsync("updateMapMarker", location.Latitude, location.Longitude);
            await DrawRouteAsync();
        }
    }

    private async Task DrawRouteAsync()
    {
        if (recordedLocations.Count > 1)
        {
            var latLngs = recordedLocations
                .Select(loc => new[] { loc.Latitude, loc.Longitude })  // Array de [lat, lon]
                .ToArray();
            await JS.InvokeVoidAsync("drawPolyline", recordedLocations);
        }
    }

    private async Task PromptSaveRecording()
    {
        // Preguntar al usuario si quiere guardar la grabación
        var save = await DialogService.ShowConfirmationDialog("Confirmación", "¿Desea guardar la ruta grabada?");
        if (save)
        {
            var mgpx = await SaveRecordingAsGpx();
            var result = await FileSaver.SaveAsync("ruta.gpx", mgpx);



        }
    }

    private async Task<MemoryStream> SaveRecordingAsGpx()
    {
        var gpxData = GenerateGpxContent(recordedLocations);

        return new MemoryStream(Encoding.Default.GetBytes(gpxData));

    }

    private string GenerateGpxContent(List<Location> locations)
    {
        var sb = new StringBuilder();
        sb.AppendLine("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
        sb.AppendLine("<gpx version=\"1.1\" creator=\"HikerApp\">");
        sb.AppendLine("<trk>");
        sb.AppendLine("<trkseg>");
        foreach (var loc in locations)
        {
            sb.AppendLine($"<trkpt lat=\"{loc.Latitude.ToString().Replace(",", ".")}\" lon=\"{loc.Longitude.ToString().Replace(",", ".")}\">");
            sb.AppendLine($"<time>{DateTime.UtcNow:yyyy-MM-ddTHH:mm:ssZ}</time>");
            sb.AppendLine("</trkpt>");
        }
        sb.AppendLine("</trkseg>");
        sb.AppendLine("</trk>");
        sb.AppendLine("</gpx>");
        return sb.ToString();
    }


    private async Task StartUpdatingPosition()
    {
        // Cambiar el valor de la bandera
        ModoRuta = !ModoRuta;

        if (ModoRuta)
        {
            // Si se activa, iniciar la actualización de posición
            await GetLocationAsync();
            _timer = new Timer(async _ => await GetLocationAsync(), null, 0, 5000);
            await JS.InvokeVoidAsync("requestWakeLock");
        }
        else
        {
            _timer.Dispose();
            await JS.InvokeVoidAsync("releaseWakeLock");
        }
    }


    private async Task TriggerFileUpload()
    {
        // Usar JavaScript para hacer clic en el input file oculto
        await JS.InvokeVoidAsync("triggerFileInputClick");
    }

    private async Task GetLocationAsync()
    {
        var location = await GeoService.GetCurrentLocationAsync();
        if (location != null)
        {
            // Pasar las coordenadas al método JavaScript para actualizar el marcador
            await JS.InvokeVoidAsync("updateMapMarker", location.Latitude, location.Longitude);
        }
        else
        {
            // Manejar el caso en que no se pueda obtener la ubicación
            Console.WriteLine("No se pudo obtener la ubicación.");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.File;
        if (files != null)
        {
            using var stream = files.OpenReadStream();
            using var reader = new StreamReader(stream);
            var gpxContent = await reader.ReadToEndAsync();

            // Procesar y dibujar la ruta GPX en el mapa
            await LoadGpxOnMap(gpxContent);
        }
    }

    private async Task LoadGpxOnMap(string gpxContent)
    {
        // Llama a una función JavaScript para procesar y mostrar el GPX en el mapa
        await JS.InvokeVoidAsync("drawGpxOnMap", gpxContent);
    }
}
