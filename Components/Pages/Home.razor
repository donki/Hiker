@page "/"
@inject IJSRuntime JS
@inject GeolocationService GeoService

<!--<div id="ad-container" style="width: 100%; height: 50px;"></div>-->
<!-- Mapa que ocupa todo el espacio -->
<div id="map" style="width: 100%; height: 100vh;"></div>


<!-- Div para mostrar la distancia total -->
<div id="distance" style="text-align: center; margin-top: 10px; font-weight: bold;">
    Distancia total: 0 km
</div>

@code {



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeAd");

            // Inicializar el mapa al cargar la página
            await JS.InvokeVoidAsync("initializeMap");

            // Obtener la posición actual y actualizar el marcador en el mapa
            await GetLocationAsync();
        }
    }

    private async Task GetLocationAsync()
    {
        var location = await GeoService.GetCurrentLocationAsync();
        if (location != null)
        {
            // Pasar las coordenadas al método JavaScript para actualizar el marcador
            await JS.InvokeVoidAsync("updateMapMarker", location.Latitude, location.Longitude);
        }
        else
        {
            // Manejar el caso en que no se pueda obtener la ubicación
            Console.WriteLine("No se pudo obtener la ubicación.");
        }
    }

}