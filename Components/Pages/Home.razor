@page "/"
@inject IJSRuntime JS
@inject GeolocationService GeoService
@inject RouteService RouteService
@inject SettingsService SettingsService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject RouteService RouteService;
@inject GpsFilterService GpsFilterService;
@inject TranslationService TranslationService



<div id="map" style="width: 100%; height: 100vh;"></div>

<button class="hamburger-button" @onclick="ToggleNavMenu">
    <span class="hamburger-icon">&#9776;</span>
</button>

@if (SettingsService.AppSettings.ShowlocalizationData)
{
    <div id="coordinatesDiv" class="floating-coordinates">
        @TranslationService.Translate("Lat:") @currentLatitude, @TranslationService.Translate("Lon:") @currentLongitude , @TranslationService.Translate("Points:") @recordedLocations.Count
    </div>
}
@if (isNavMenuOpen)
{
    <nav class="hamburger-menu flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link bi bi-cloud-upload-fill" href="loadroute">
                <span class="me-2"></span> @TranslationService.Translate("Cargar Ruta")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="#" class="nav-link" @onclick="StartUpdatingPosition">

                <span style="display: inline-flex; align-items: center; line-height: 1;">
                    @if (ModoRuta)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="lime" class="bi bi-geo-alt-fill" viewBox="0 0 16 16" style="vertical-align: middle; margin-right: 4px;">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>

                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gray" class="bi bi-geo-alt-fill" viewBox="0 0 16 16" style="vertical-align: middle; margin-right: 4px;">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>

                    }
                    @TranslationService.Translate("Modo Ruta")
                </span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="#" class="nav-link" @onclick="ToggleRecordingMode">

                <span style="display: inline-flex; align-items: center; line-height: 1;">
                    @if (ModoGrabacion)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 4px;">
                            <circle cx="256" cy="256" r="256" fill="red" />
                        </svg>

                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 4px;">
                            <circle cx="256" cy="256" r="256" fill="gray" />
                        </svg>

                    }
                    @TranslationService.Translate("Modo Grabación")
                </span>
            </NavLink>
            <InputFile id="gpxFileInput" OnChange="HandleFileSelected" style="display:none;" />
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link bi bi-gear-fill" @onclick="OpenSettings">
                <span class="me-2"></span> @TranslationService.Translate("Configuración")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link bi bi-info-circle-fill" Match="NavLinkMatch.All" @onclick="OpenAbout">
                <span class="me-2"></span> @TranslationService.Translate("Acerca de...")
            </NavLink>
        </div>



    </nav>

}


<style>

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .dialog-container {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        width: 300px;
    }

    .route-input {
        width: 100%;
        padding: 10px;
        margin-top: 10px;
        font-size: 16px;
    }

    .dialog-buttons {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
    }

    .btn-save, .btn-cancel {
        padding: 10px 20px;
        cursor: pointer;
    }

    .btn-save {
        background-color: #28a745;
        color: white;
        border: none;
    }

    .btn-cancel {
        background-color: #dc3545;
        color: white;
        border: none;
    }

    .floating-coordinates {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        padding: 10px;
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        font-size: 14px;
        border-radius: 5px;
        z-index: 10000;
    }
    /* Botón flotante de hamburguesa */
    .hamburger-button {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 60px;
        height: 60px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 50px;
        box-shadow: 0px 4px 10px black; /* Sombra del menú */
        font-size: 24px;
        cursor: pointer;
        z-index: 99999; /* Asegura que esté por encima del menú */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .hamburger-menu {
        position: fixed;
        bottom: 90px;
        right: 20px;
        width: auto;
        height: auto;
        color: white;
        background-color: #007bff;
        border-radius: 5px;
        box-shadow: 0px 4px 10px black; /* Sombra del menú */
        z-index: 99999; /* Asegura que esté por encima del menú */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .hamburger-icon {
        font-size: 30px;
    }
</style>


@code {
    private bool ModoRuta = false;
    private bool ModoGrabacion = false;
    private List<Location> recordedLocations = new();
    private double currentLatitude;
    private double currentLongitude;
    private bool isNavMenuOpen = false;
    private string DefaultRouteName = "R. " + DateTime.Now.ToString("ddMMyyyyHHmm");


    private async Task PromptSaveRecording()
    {
        // Preguntar al usuario si quiere guardar la grabación
        var save = await DialogService.ShowConfirmationDialog(TranslationService.Translate("Confirmación"), TranslationService.Translate("¿Desea guardar la ruta grabada?"));
        if (save)
        {
            await RouteService.SetLocations(recordedLocations);
            Navigation.NavigateTo("/saveroute");
            recordedLocations.Clear();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await SettingsService.LoadSettingsAsync();
    }

    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeMap", "<i class=\"bi bi-geo-alt-fill fs-6 text-success\"></i>" + TranslationService.Translate("Estás aquí..."));

            var gpxContent = RouteService.GetRoute();
            if (!string.IsNullOrEmpty(gpxContent))
            {
                await JS.InvokeVoidAsync("drawGpxOnMap", gpxContent);

            }
            else
            {
                await GetLocationAsync(await GeoService.GetCurrentLocationAsync());
            }
        }
    }


    #region RECORD ROUTE

    private async Task RecordLocationAsync(Location location)
    {
        if (location != null)
        {
            //location = GpsFilterService.ProcessLocation(location);

            recordedLocations.Add(location);

            await JS.InvokeVoidAsync("updateMapMarker", "<i class=\"bi bi-record-fill fs-6 text-danger\"></i>" + TranslationService.Translate("Grabando..."), location.Latitude, location.Longitude, location.Course);
            await DrawRecordingRouteAsync();
        }
    }

    private async Task DrawRecordingRouteAsync()
    {
        if (recordedLocations.Count > 1)
        {
            var latLngs = recordedLocations
                .Select(loc => new[] { loc.Latitude, loc.Longitude })  // Array de [lat, lon]
                .ToArray();
            await JS.InvokeVoidAsync("drawPolyline", recordedLocations);
        }
    }

    private async Task ToggleRecordingMode()
    {
        isNavMenuOpen = false;
        ModoGrabacion = !ModoGrabacion;

        if (ModoGrabacion)
        {
            StartRecordingMode();
        }
        else
        {
            StopRecordingMode();
        }
    }

    private async Task StopRecordingMode()
    {
        await PromptSaveRecording();
        await JS.InvokeVoidAsync("releaseWakeLock");
        GeoService.ListeningStopAsync();
        RouteService.isRecording = false;
    }

    private async Task StartRecordingMode()
    {
        ModoRuta = false;
        recordedLocations.Clear();
        RouteService.isRecording = true;
        await JS.InvokeVoidAsync("requestWakeLock");
        RecordLocationAsync(await GeoService.GetCurrentLocationAsync());
        GeoService.OnLocationChangedDelegate += LocationChange;
        await GeoService.ListeningStartAsync();

    }
    #endregion



    public void LocationChange(Location location)
    {

        if (ModoGrabacion)
        {
            currentLatitude = location.Latitude;
            currentLongitude = location.Longitude;

            RecordLocationAsync(location);
        }
        else
        {
            GetLocationAsync(location);
        }
    }

    #region TRACK ROUTE
    private async Task StartUpdatingPosition()
    {
        isNavMenuOpen = false;

        ModoRuta = !ModoRuta;

        if (ModoRuta)
        {
            if (ModoGrabacion)
            {
                await StopRecordingMode();
                ModoGrabacion = false;
            }

            GeoService.OnLocationChangedDelegate += LocationChange;
            await GeoService.ListeningStartAsync();

            await JS.InvokeVoidAsync("requestWakeLock");
        }
        else
        {
            await JS.InvokeVoidAsync("releaseWakeLock");
            GeoService.ListeningStopAsync();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.File;
        if (files != null)
        {
            using var stream = files.OpenReadStream();
            using var reader = new StreamReader(stream);
            var gpxContent = await reader.ReadToEndAsync();

            // Procesar y dibujar la ruta GPX en el mapa
            await LoadGpxOnMap(gpxContent);
        }
    }

    private async Task LoadGpxOnMap(string gpxContent)
    {
        JS.InvokeVoidAsync("drawGpxOnMap", gpxContent);
    }

    private async Task TriggerFileUpload()
    {
        isNavMenuOpen = false;
        //await JS.InvokeVoidAsync("triggerFileInputClick");

    }

    private async Task GetLocationAsync(Location location)
    {
        if (location != null)
        {
            currentLatitude = location.Latitude;
            currentLongitude = location.Longitude;
            if (RouteService.isRecording)
            {
                await JS.InvokeVoidAsync("updateMapMarker", "<i class=\"bi bi-record-fill fs-6 text-danger\"></i>" + TranslationService.Translate("Grabando..."), location.Latitude, location.Longitude, location.Course);
            }
            {
                await JS.InvokeVoidAsync("updateMapMarker", "<i class=\"bi bi-geo-alt-fill fs-6 text-success\"></i>" + TranslationService.Translate("Estás aquí..."), location.Latitude, location.Longitude, location.Course);
            }
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("No se pudo obtener la ubicación.");
        }
    }

    #endregion


    private async Task OpenSettings()
    {

        if (ModoGrabacion)
        {
            await StopRecordingMode();
            await GeoService.ListeningStopAsync();
        }

        Navigation.NavigateTo("/settings");
    }

    private async Task OpenAbout()
    {

        if (ModoGrabacion)
        {
            await StopRecordingMode();
            await GeoService.ListeningStopAsync();
        }

        Navigation.NavigateTo("/about");
    }

}