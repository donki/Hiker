@page "/"
@inject IJSRuntime JS
@inject GeolocationService GeoService
@inject RouteService RouteService


<!--<div id="ad-container" style="width: 100%; height: 50px;"></div>-->
<!-- Mapa que ocupa todo el espacio -->
<div id="map" style="width: 100%; height: 100vh;"></div>

<NavMenu isMenuOpen="isNavMenuOpen" OnToggleMenu="ToggleNavMenu">></NavMenu>
<button class="hamburger-button" @onclick="ToggleNavMenu">
    <span class="hamburger-icon">&#9776;</span>
</button>


@code {


    private bool isNavMenuOpen = false;

    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeMap");

            // Obtener la ruta almacenada en RouteService
            var gpxContent = RouteService.GetRoute();
            if (!string.IsNullOrEmpty(gpxContent))
            {
                // Llama a la función JavaScript para dibujar la ruta en el mapa
                await JS.InvokeVoidAsync("drawGpxOnMap", gpxContent);
                RouteService.SetRoute("");

                // Obtener la posición actual y actualizar el marcador en el mapa
            }
            else
            {
                await GetLocationAsync();
            }
        }
    }


    private async Task GetLocationAsync()
    {
        var location = await GeoService.GetCurrentLocationAsync();
        if (location != null)
        {
            if (RouteService.isRecording)
            {
                await JS.InvokeVoidAsync("updateMapMarker", "Grabando aquí...", location.Latitude, location.Longitude);
            }
            {
                await JS.InvokeVoidAsync("updateMapMarker", "Estas aquí...", location.Latitude, location.Longitude);
            }

        }
        else
        {
            // Manejar el caso en que no se pueda obtener la ubicación
            Console.WriteLine("No se pudo obtener la ubicación.");
        }
    }


}