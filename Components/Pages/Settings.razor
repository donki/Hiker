@page "/settings"
@inject SettingsService SettingsService
@inject NavigationManager Navigation
@inject TranslationService TranslationService



<div class="modern-header">
    <RadzenRow AlignItems="AlignItems.Center" Style="height: 64px; padding: 0 16px;">
        <RadzenColumn Size="2">
            <RadzenButton Text="" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Navigation.NavigateTo("/"))"
                          Icon="arrow_back"
                          Style="height: 48px; width: 48px; border-radius: 50%; background: rgba(255,255,255,0.2); color: white; border: none; backdrop-filter: blur(10px);" />
        </RadzenColumn>
        <RadzenColumn Size="8">
            <RadzenText TextStyle="TextStyle.H4" Style="text-align: center; color: white; font-weight: 600; margin: 0;">
                @TranslationService.Translate("Configuración")
            </RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="2">
            <RadzenButton Icon="save" Click="@Save" ButtonStyle="ButtonStyle.Light" 
                          Style="height: 48px; width: 48px; border-radius: 50%; background: rgba(255,255,255,0.2); color: white; border: none; backdrop-filter: blur(10px);" />
        </RadzenColumn>
    </RadzenRow>
</div>

<div class="settings-container">
    <div class="settings-card">
        <div class="setting-group">
            <h3 class="setting-group-title">@TranslationService.Translate("General")</h3>
            
            <div class="setting-item">
                <label class="setting-label">@TranslationService.Translate("Idioma del sistema")</label>
                <RadzenDropDown @bind-Value="selectedLanguage"
                                Data="@languages"
                                TextProperty="Name"
                                ValueProperty="Code"
                                Change="OnLanguageChanged"
                                Style="width: 100%; border-radius: 12px; border: 2px solid #e0e0e0; padding: 12px;">
                    <Template Context="lang">
                        <div style="display: flex; align-items: center;">
                            <img src="@lang.FlagUrl" alt="@lang.Name" width="24" height="24" style="margin-right: 12px; border-radius: 4px;" />
                            @lang.Name
                        </div>
                    </Template>
                </RadzenDropDown>
            </div>
        </div>

        <div class="setting-group">
            <div class="setting-item">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <div>
                        <RadzenLabel Text="@TranslationService.Translate("Mostrar datos de localización")" Style="font-weight: 500; color: #333;" />
                        <div class="setting-description">Muestra coordenadas en tiempo real</div>
                    </div>
                    <RadzenSwitch @bind-Value="SettingsService.AppSettings.ShowlocalizationData" Style="--rz-switch-color: #4CAF50;" />
                </RadzenStack>
            </div>

            <div class="setting-item">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <div>
                        <RadzenLabel Text="@TranslationService.Translate("Configuración avanzada")" Style="font-weight: 500; color: #333;" />
                        <div class="setting-description">Opciones para usuarios expertos</div>
                    </div>
                    <RadzenSwitch @bind-Value="AdvancedSettings" Style="--rz-switch-color: #4CAF50;" />
                </RadzenStack>
            </div>
        </div>

        @if (AdvancedSettings)
        {
            <div class="setting-group advanced-settings">
                <h3 class="setting-group-title">@TranslationService.Translate("Configuración Avanzada")</h3>
                
                <div class="setting-item">
                    <label class="setting-label">@TranslationService.Translate("Precisión (m)")</label>
                    <RadzenNumeric @bind-Value="SettingsService.AppSettings.Accuracy" Min="0" Max="100" Step="1" 
                                   Style="width: 100%; border-radius: 12px; border: 2px solid #e0e0e0; padding: 12px;" />
                    <div class="setting-description">Precisión mínima requerida para GPS</div>
                </div>

                <div class="setting-item">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <div>
                            <RadzenLabel Text="@TranslationService.Translate("Filtro de precisión")" Style="font-weight: 500; color: #333;" />
                            <div class="setting-description">Filtra puntos con baja precisión</div>
                        </div>
                        <RadzenSwitch @bind-Value="SettingsService.AppSettings.AccuracyFilterEnabled" Style="--rz-switch-color: #4CAF50;" />
                    </RadzenStack>
                </div>

                <div class="setting-item">
                    <label class="setting-label">@TranslationService.Translate("Velocidad máxima (m/s)")</label>
                    <RadzenNumeric @bind-Value="SettingsService.AppSettings.MaxSpeed" Min="0" Max="10" Step="0.1" 
                                   Style="width: 100%; border-radius: 12px; border: 2px solid #e0e0e0; padding: 12px;" />
                    <div class="setting-description">Velocidad máxima permitida para filtrado</div>
                </div>

                <div class="setting-item">
                    <label class="setting-label">@TranslationService.Translate("Refresco posición (s)")</label>
                    <RadzenNumeric @bind-Value="SettingsService.AppSettings.TimerInterval" Min="1" Max="60" Step="1" 
                                   Style="width: 100%; border-radius: 12px; border: 2px solid #e0e0e0; padding: 12px;" />
                    <div class="setting-description">Intervalo de actualización de posición</div>
                </div>

                <div class="setting-item">
                    <label class="setting-label">@TranslationService.Translate("Elementos para el promedio móvil")</label>
                    <RadzenNumeric @bind-Value="SettingsService.AppSettings.WindowSize" Min="1" Max="10" Step="1" 
                                   Style="width: 100%; border-radius: 12px; border: 2px solid #e0e0e0; padding: 12px;" />
                    <div class="setting-description">Número de puntos para calcular promedio</div>
                </div>

                <div class="filters-section">
                    <h4 class="filter-title">Filtros de GPS</h4>
                    
                    <div class="setting-item">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenLabel Text="@TranslationService.Translate("Filtro de Kalman")" Style="font-weight: 500; color: #333;" />
                                <div class="setting-description">Suaviza la trayectoria GPS</div>
                            </div>
                            <RadzenSwitch @bind-Value="SettingsService.AppSettings.KalmanFilterEnabled" Style="--rz-switch-color: #4CAF50;" />
                        </RadzenStack>
                    </div>

                    <div class="setting-item">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenLabel Text="@TranslationService.Translate("Filtro de Promedio Móvil")" Style="font-weight: 500; color: #333;" />
                                <div class="setting-description">Promedia las últimas posiciones</div>
                            </div>
                            <RadzenSwitch @bind-Value="SettingsService.AppSettings.AverageFilterEnabled" Style="--rz-switch-color: #4CAF50;" />
                        </RadzenStack>
                    </div>

                    <div class="setting-item">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenLabel Text="@TranslationService.Translate("Filtro de velocidad")" Style="font-weight: 500; color: #333;" />
                                <div class="setting-description">Filtra por velocidad máxima</div>
                            </div>
                            <RadzenSwitch @bind-Value="SettingsService.AppSettings.SpeedFilterEnabled" Style="--rz-switch-color: #4CAF50;" />
                        </RadzenStack>
                    </div>

                    <div class="setting-item">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenLabel Text="@TranslationService.Translate("Usar geolocalización nativa MAUI")" Style="font-weight: 500; color: #333;" />
                                <div class="setting-description">Usa API nativa del dispositivo</div>
                            </div>
                            <RadzenSwitch @bind-Value="SettingsService.AppSettings.UseNativeGeolocation" Style="--rz-switch-color: #4CAF50;" />
                        </RadzenStack>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string selectedLanguage;
    private List<Language> languages;
    private Boolean AdvancedSettings = false;

    protected override async Task OnInitializedAsync()
    {
        languages = new List<Language>
        {
            new Language { Code = "es", Name = TranslationService.Translate("Castellano"), FlagUrl = "images/spain-flag.png" },
            new Language { Code = "en", Name = TranslationService.Translate("English"), FlagUrl = "images/uk-flag.png" },
            new Language { Code = "ca", Name = TranslationService.Translate("Catalan"), FlagUrl = "images/catalan-flag.png" }
        };

        // Obtener el idioma guardado de la configuración o asignar por defecto
        selectedLanguage = SettingsService.AppSettings.Language ?? "es";
    }

    private void OnLanguageChanged(object value)
    {
        selectedLanguage = value.ToString();
        SettingsService.AppSettings.Language = selectedLanguage;

        // Cambiar el idioma en TranslationService (asumiendo que TranslationService tiene un método para cambiar el idioma)
        TranslationService.SetLanguage(selectedLanguage);
        StateHasChanged();
    }

    private async Task Save()
    {
        await SettingsService.SaveSettingsAsync();
        Navigation.NavigateTo("/");
    }

    private async Task Close()
    {
        Navigation.NavigateTo("/");
    }

    // Clase para representar los idiomas
    public class Language
    {
        public string Code { get; set; }
        public string Name { get; set; }
        public string FlagUrl { get; set; }
    }
}
