@page "/settings"
@inject SettingsService SettingsService
@inject NavigationManager Navigation
@inject TranslationService TranslationService

<RadzenStack Style="padding: 20px; max-width: 800px; margin: auto;">
    <RadzenText TextStyle="TextStyle.H3" Style="margin-bottom: 20px;">@TranslationService.Translate("Configuración")</RadzenText>

    <label for="language">@TranslationService.Translate("Idioma del sistema"):</label>
    <RadzenDropDown @bind-Value="selectedLanguage"
                    Data="@languages"
                    TextProperty="Name"
                    ValueProperty="Code"
                    Change="OnLanguageChanged"
                    Style="width: 100%;">
        <Template Context="lang">
            <img src="@lang.FlagUrl" alt="@lang.Name" width="24" height="24" style="margin-right:10px" />
            @lang.Name
        </Template>
    </RadzenDropDown>

    <label for="maxSpeed">@TranslationService.Translate("Velocidad máxima (m/s)"):</label>
    <RadzenNumeric @bind-Value="SettingsService.AppSettings.MaxSpeed" Min="0" Max="10" Step="0.1" />

    <label for="timerInterval">@TranslationService.Translate("Refresco posición (s)"):</label>
    <RadzenNumeric @bind-Value="SettingsService.AppSettings.TimerInterval" Min="1" Max="60" Step="1" />

    <label for="windowSize">@TranslationService.Translate("Elementos para el promedio móvil"):</label>
    <RadzenNumeric @bind-Value="SettingsService.AppSettings.WindowSize" Min="1" Max="10" Step="1" />

    <label for="kalmanEnabled">@TranslationService.Translate("Filtro de Kalman")</label>
    <RadzenSwitch @bind-Value="SettingsService.AppSettings.KalmanFilterEnabled" />

    <label for="averageFilterEnabled">@TranslationService.Translate("Filtro de Promedio Móvil")</label>
    <RadzenSwitch @bind-Value="SettingsService.AppSettings.AverageFilterEnabled" />

    <label for="distanceFilterEnabled">@TranslationService.Translate("Mostrar datos de localización")</label>
    <RadzenSwitch @bind-Value="SettingsService.AppSettings.ShowlocalizationData" />

    <div style="margin-top: 20px; display:flex; justify-content:center">
        <RadzenButton Text="@TranslationService.Translate("Guardar")" Click="@SaveSettings" ButtonStyle="ButtonStyle.Primary" Style="margin-right:20px" />
        <RadzenButton Text="@TranslationService.Translate("Cerrar")" Click="@Close" ButtonStyle="ButtonStyle.Secondary" />
    </div>

</RadzenStack>

@code {
    private string selectedLanguage;
    private List<Language> languages;

    protected override async Task OnInitializedAsync()
    {
        languages = new List<Language>
        {
            new Language { Code = "es", Name = "Castellano", FlagUrl = "images/spain-flag.png" },
            new Language { Code = "en", Name = "English", FlagUrl = "images/uk-flag.png" }
        };

        // Obtener el idioma guardado de la configuración o asignar por defecto
        selectedLanguage = SettingsService.AppSettings.Language ?? "es";
    }

    private void OnLanguageChanged(object value)
    {
        selectedLanguage = value.ToString();
        SettingsService.AppSettings.Language = selectedLanguage;

        // Cambiar el idioma en TranslationService (asumiendo que TranslationService tiene un método para cambiar el idioma)
        TranslationService.SetLanguage(selectedLanguage);
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync();
        Navigation.NavigateTo("/");
    }

    private async Task Close()
    {
        Navigation.NavigateTo("/");
    }

    // Clase para representar los idiomas
    public class Language
    {
        public string Code { get; set; }
        public string Name { get; set; }
        public string FlagUrl { get; set; }
    }
}
