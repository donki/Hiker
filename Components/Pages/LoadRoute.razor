@page "/loadroute"
@inject IJSRuntime JS
@inject IFileSaver FileSaver
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject RouteService RouteService
@inject SettingsService SettingsService

<h3>Cargar Ruta</h3>

<RadzenButton Text="Cargar Ruta GPX" Click="@OpenFileDialog" />

@if (!string.IsNullOrEmpty(routeName))
{
    <h4>Ruta: @routeName</h4>
    <p><strong>Distancia Total:</strong> @totalDistance Km</p>
    <p><strong>Elevación Mínima:</strong> @minElevation metros</p>
    <p><strong>Elevación Máxima:</strong> @maxElevation metros</p>
    <p><strong>Desnivel:</strong> @desnivel metros</p>
    <p><strong>Tiempo Estimado:</strong> @estimatedTime horas</p>
}

<InputFile id="gpxFileInput" style="display:none;" OnChange="OnFileSelected" />

@if (!string.IsNullOrEmpty(gpxContent))
{
    <div style="margin-top: 20px;">
        <RadzenButton Text="Cargar Ruta" ButtonStyle="ButtonStyle.Primary" Click="LoadRouteOnMap" Style="margin-right: 10px;" />
        <RadzenButton Text="Cerrar" ButtonStyle="ButtonStyle.Secondary" Click="CloseDialog" />
    </div>
}

@code {
    private string routeName = "Ruta sin nombre";
    private double totalDistance;
    private double minElevation;
    private double maxElevation;
    private double desnivel;
    private double estimatedTime; // Tiempo estimado en horas para recorrer la ruta
    private string gpxContent;

    private async Task OpenFileDialog()
    {
        await JS.InvokeVoidAsync("triggerFileInputClick");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream();
            using var reader = new StreamReader(stream);
            gpxContent = await reader.ReadToEndAsync();

            ProcessGpxData(gpxContent);
        }
    }

    private void ProcessGpxData(string gpxContent)
    {
        if (string.IsNullOrEmpty(gpxContent))
        {
            Console.WriteLine("El contenido del archivo GPX está vacío.");
            return;
        }

        try
        {

            // Parsear el archivo GPX con soporte para namespaces
            var xmlDocument = new System.Xml.XmlDocument();
            xmlDocument.LoadXml(gpxContent);

            // Definir el espacio de nombres (namespace) utilizado en el archivo GPX
            var namespaceManager = new System.Xml.XmlNamespaceManager(xmlDocument.NameTable);
            namespaceManager.AddNamespace("default", "http://www.topografix.com/GPX/1/1");

            // Extraer el nombre de la ruta (si está disponible)
            var nameNode = xmlDocument.SelectSingleNode("//default:gpx/default:trk/default:name", namespaceManager);
            routeName = nameNode?.InnerText ?? "Ruta sin nombre";
            Console.WriteLine("Nombre de la ruta: " + routeName);

            // Extraer los puntos de la ruta (trkpt)
            var trackPoints = xmlDocument.SelectNodes("//default:gpx/default:trk/default:trkseg/default:trkpt", namespaceManager);

            if (trackPoints == null || trackPoints.Count < 2)
            {
                Console.WriteLine("No se encontraron suficientes puntos en la ruta.");
                return; // No se puede calcular la ruta si no hay al menos dos puntos
            }

            double totalDistanceInMeters = 0;
            double? prevLatitude = null;
            double? prevLongitude = null;
            minElevation = double.MaxValue;
            maxElevation = double.MinValue;

            DateTime? startTime = null;
            DateTime? endTime = null;

            foreach (System.Xml.XmlNode point in trackPoints)
            {
                double lat = double.Parse(point.Attributes["lat"].Value);
                double lon = double.Parse(point.Attributes["lon"].Value);
                long timestamp = DateTime.Parse(point.SelectSingleNode("default:time", namespaceManager)?.InnerText ?? DateTime.UtcNow.ToString())
                 .ToUniversalTime().Ticks / TimeSpan.TicksPerMillisecond;

                // Calcular distancia entre puntos consecutivos
                if (prevLatitude.HasValue && prevLongitude.HasValue)
                {
                    double distance = Location.CalculateDistance(prevLatitude.Value, prevLongitude.Value, lat, lon, DistanceUnits.Kilometers);
                    totalDistanceInMeters += distance * 1000; // Convertir a metros
                }

                prevLatitude = lat;
                prevLongitude = lon;

                // Extraer elevación
                var eleNode = point.SelectSingleNode("default:ele", namespaceManager);
                if (eleNode != null)
                {
                    double elevation = double.Parse(eleNode.InnerText);
                    if (elevation < minElevation)
                    {
                        minElevation = elevation;
                    }
                    if (elevation > maxElevation)
                    {
                        maxElevation = elevation;
                    }
                }

                // Extraer tiempo (si está presente)
                var timeNode = point.SelectSingleNode("default:time", namespaceManager);
                if (timeNode != null)
                {
                    var time = DateTime.Parse(timeNode.InnerText);
                    if (startTime == null)
                    {
                        startTime = time;
                    }
                    endTime = time;
                }
            }


            desnivel = maxElevation - minElevation;
            // Calcular la distancia total en kilómetros
            totalDistance = totalDistanceInMeters / 1000;
            Console.WriteLine("Distancia total: " + totalDistance + " km");

            // Calcular el tiempo estimado basado en la distancia (asumiendo velocidad promedio de 5 km/h)
            estimatedTime = totalDistance / 5;

            // Calcular el tiempo real si hay marcas de tiempo
            if (startTime.HasValue && endTime.HasValue)
            {
                TimeSpan timeSpan = endTime.Value - startTime.Value;
                estimatedTime = timeSpan.TotalHours;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al procesar el archivo GPX: {ex.Message}");
        }
    }

    private void LoadRouteOnMap()
    {
        // Almacena el contenido GPX en el servicio compartido
        RouteService.SetRoute(gpxContent);

        // Redirige al componente Home para cargar la ruta en el mapa
        Navigation.NavigateTo("/");
    }

    private void CloseDialog()
    {
        Navigation.NavigateTo("/");
    }
}
