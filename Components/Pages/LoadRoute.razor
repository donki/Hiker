@page "/loadroute"
@inject IJSRuntime JS
@inject IFileSaver FileSaver
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject RouteService RouteService
@inject SettingsService SettingsService
@inject TranslationService TranslationService

<RadzenRow Style="border-bottom: 1px solid #ccc; margin-left:5px; margin-right:5px;">
    <RadzenColumn Size="2">
        <RadzenButton Text="" ButtonStyle="ButtonStyle.Secondary"
                      Click="@(() => Navigation.NavigateTo("/"))"
                      Icon="arrow_back"
                      Style="height: 98% !important; width:100%;" />
    </RadzenColumn>
    <RadzenColumn Size="8">
        <RadzenText TextStyle="TextStyle.H4" Style="text-align: center;">@TranslationService.Translate("Cargar")</RadzenText>
    </RadzenColumn>
    <RadzenColumn Size="2" Style="display: flex; justify-content: flex-end; align-items: center;">
        <RadzenButton Icon="upload_file" Click="@OpenFileDialog" ButtonStyle="ButtonStyle.Secondary" Style="height: 98% !important;width:100%;margin-right:2px" />
        @if (!string.IsNullOrEmpty(gpxContent))
        {
            <RadzenButton Icon="route" Click="@LoadRouteOnMap" ButtonStyle="ButtonStyle.Secondary" Style="height: 98% !important;width:100%;margin-right:1px" />
        }
    </RadzenColumn>
</RadzenRow>

<RadzenStack Style="padding: 20px; max-width: 800px; margin: auto;">

    @if (!string.IsNullOrEmpty(gpxContent))
    {
        <h4>@TranslationService.Translate("Ruta"): @routeName</h4>
        <p><strong>@TranslationService.Translate("Distancia Total"):</strong> @FormatingHelper.FloatToStr(totalDistance) Km</p>
        <p><strong>@TranslationService.Translate("Elevación Mínima"):</strong> @FormatingHelper.FloatToStr(minElevation) m</p>
        <p><strong>@TranslationService.Translate("Elevación Máxima"):</strong> @FormatingHelper.FloatToStr(maxElevation) m</p>
        <p><strong>@TranslationService.Translate("Desnivel"):</strong> @FormatingHelper.FloatToStr(desnivel) m</p>
        <p><strong>@TranslationService.Translate("Tiempo Estimado"):</strong> @sEstimatedTime h</p>

        <RadzenChart>
            <RadzenLineSeries Smooth="true" Data="@elevationData" CategoryProperty="Distance" ValueProperty="Elevation" LineType="LineType.Solid" Title="@TranslationService.Translate("Elevación")" />
            <RadzenLegend Position="LegendPosition.Top" />
            <RadzenCategoryAxis Min="0" Max="@totalDistance" Step="@stepDistance" />
        </RadzenChart>
    }

    <InputFile id="gpxFileInput" style="display:none;" OnChange="OnFileSelected" />

</RadzenStack>

@if (isLoading)
{
    <div class="overlay">
        <div class="spinner-container">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p>@TranslationService.Translate("Por favor, espera...")</p>
        </div>
    </div>
}


<style>
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Fondo oscuro semitransparente */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000; /* Asegura que esté por encima de otros elementos */
    }

    .spinner-container {
        background-color: white; /* Fondo blanco */
        padding: 20px;
        border-radius: 10px; /* Bordes redondeados */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Sombra para efecto visual */
        text-align: center;
        width: 300px; /* Ancho fijo */
        height: 150px; /* Alto fijo */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .spinner-container p {
            margin-top: 10px;
            font-size: 18px;
            color: black; /* Color del texto */
        }
</style>


@code {
    private string routeName = "Ruta sin nombre";
    private bool isLoading = false;
    private double totalDistance;
    private double minElevation;
    private double maxElevation;
    private double stepDistance = 20;
    private double desnivel;
    private string sEstimatedTime; // Tiempo estimado en horas para recorrer la ruta
    private List<ElevationPoint> elevationData = new List<ElevationPoint>();
    private string gpxContent = null;
    private async Task OpenFileDialog()
    {
        await JS.InvokeVoidAsync("triggerFileInputClick");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        isLoading = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream();
                using var reader = new StreamReader(stream);
                gpxContent = await reader.ReadToEndAsync();

                var routeData = await RouteService.SetRoute(gpxContent);
                totalDistance = routeData.totalDistance;
                minElevation = routeData.minElevation;
                maxElevation = routeData.maxElevation;
                stepDistance = routeData.stepDistance == 0 ? 1 : routeData.stepDistance;
                desnivel = routeData.desnivel;
                elevationData = routeData.elevationData;
                routeName = routeData.routeName;
                sEstimatedTime = routeData.estimatedTime.Hours + ":" + routeData.estimatedTime.Minutes;
            }

        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    private void LoadRouteOnMap()
    {
        // Redirige al componente Home para cargar la ruta en el mapa
        Navigation.NavigateTo("/");
    }

    private void CloseDialog()
    {
        Navigation.NavigateTo("/");
    }


}
