@page "/buymeacoffe"
@inject NavigationManager Navigation
@inject TranslationService TranslationService

<RadzenRow Style="background-color:#007bff">
    <RadzenColumn Size="2">
        <RadzenButton Text="" ButtonStyle="ButtonStyle.Secondary"
                      Click="@(() => Navigation.NavigateTo("/"))"
                      Icon="arrow_back"
                      Style="height: 98% !important; width: 100%; background-color: #007bff; color: white;" />
    </RadzenColumn>
    <RadzenColumn Size="8">
        <RadzenText TextStyle="TextStyle.H4" Style="text-align: center; color: white;">
            @TranslationService.Translate("Invitame a un Café")
        </RadzenText>
    </RadzenColumn>
    <RadzenColumn Size="2">
    </RadzenColumn>
</RadzenRow>

<RadzenStack Style="padding: 20px; max-width: 800px; margin: auto;">
    <RadzenText TextStyle="TextStyle.H5" Style="margin-bottom: 20px;" Text="@TranslationService.Translate("ThaksForYourSupport")" />

    <div style="text-align: center; margin-top: 20px;">
        <a href="https://ko-fi.com/josepsola" target="_blank">
            <img height="45" style="border:0px;height:45px;" src="https://cdn.ko-fi.com/cdn/kofi1.png?v=3" />
        </a>
    </div>
</RadzenStack>
