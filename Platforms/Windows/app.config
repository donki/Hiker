<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization=false" />
    <gcServer enabled="true"/>
    <gcConcurrent enabled="true"/>
    <ThrowUnobservedTaskExceptions enabled="false"/>
  </runtime>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="console" type="System.Diagnostics.ConsoleTraceListener" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>