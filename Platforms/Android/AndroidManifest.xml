<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Hiker" android:screenOrientation="portrait"></application>
  <!-- Permisos justificados (constitución §A.3: cada permiso justificado, mínimo privilegio). -->

  <!-- INTERNET: descarga de teselas del mapa (MapLibre GL + OpenFreeMap) en el WebView. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Ubicación: es una app de senderismo/GPS; registra la ruta del usuario en primer plano. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- Almacenamiento externo: solo necesario en Android antiguo. Desde Android 11+ (API 30)
       FileSaver del CommunityToolkit usa SAF y no requiere estos permisos. Se acotan por
       minimo privilegio (constitucion seccion 5) para no solicitarlos en Android moderno. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <!-- REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: el usuario puede pedir excluir la app de la
       optimización de batería para que el GPS no se corte durante una ruta larga (MainActivity). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- FOREGROUND_SERVICE (+ el tipo LOCATION que exige Android 14): mientras se GRABA una ruta,
       un servicio en primer plano con notificación permanente mantiene vivo el proceso. Sin él,
       Android deja de entregar posiciones a los pocos minutos de apagar la pantalla y la
       grabación sale a trozos, que es justo lo que una app de senderismo no puede permitirse.
       El servicio se arranca con la app en pantalla y se para al terminar la grabación. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- POST_NOTIFICATIONS: solo para esa notificación de "grabando", obligatoria en Android 13+. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    WAKE_LOCK: mantiene la CPU despierta mientras se graba una ruta con la pantalla apagada. Sin
    ella el sistema duerme el procesador entre posicion y posicion y la traza sale a trozos. Solo
    se coge mientras dura la grabacion y se suelta al parar.
  -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Retirados por no usarse (mínimo privilegio):
       - ACCESS_NETWORK_STATE: default de la plantilla MAUI, ninguna API de conectividad se usa.
       - ACCESS_WIFI_STATE: sin uso de WifiManager en el código.
       - ACCESS_BACKGROUND_LOCATION: no hace falta. Con un servicio en primer plano de tipo
         "location" arrancado con la app visible, Android sigue entregando posiciones. Es un
         permiso de alta revisión en Google Play que aquí no aporta nada. -->
  <uses-feature android:name="android.hardware.location" android:required="false" />
  <uses-feature android:name="android.hardware.location.gps" android:required="false" />
  <uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>