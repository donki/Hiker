<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:Hiker.Pages"
       x:Class="Hiker.AppShell"
       Title="Hiker"
       FlyoutBehavior="Flyout"
       FlyoutWidth="280"
       FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
       BackgroundColor="{StaticResource Primary}">

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="Shell.ForegroundColor" Value="{StaticResource OnPrimary}" />
                <Setter Property="Shell.TitleColor" Value="{StaticResource OnPrimary}" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Cabecera del menu -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" HeightRequest="150" Padding="20,44,20,16">
            <VerticalStackLayout VerticalOptions="End" Spacing="4">
                <Image Source="app_logo.png" WidthRequest="52" HeightRequest="52" HorizontalOptions="Start" />
                <Label Text="Hiker" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                <Label Text="Tu compañero de aventuras al aire libre"
                       FontSize="12" TextColor="{StaticResource OnPrimary}" Opacity="0.9" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Contenido del menu a medida: GPS con submenu desplegable, y el resto de opciones -->
    <Shell.FlyoutContent>
        <ScrollView>
            <VerticalStackLayout Padding="0,8" Spacing="0">

                <!-- GPS (desplegable) -->
                <Grid ColumnDefinitions="26,*,Auto" Padding="20,0" HeightRequest="52" ColumnSpacing="16">
                    <Image Grid.Column="0" Source="location.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="GPS" VerticalOptions="Center" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Grid.Column="2" x:Name="GpsChevron" Text="▸" FontSize="16" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGpsTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- Submenu de acciones del mapa (oculto hasta que se despliega) -->
                <VerticalStackLayout x:Name="GpsSubmenu" IsVisible="False"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource SubmenuBackgroundLight}, Dark={StaticResource SubmenuBackgroundDark}}">
                    <Grid ColumnDefinitions="22,*" Padding="46,0,20,0" HeightRequest="46" ColumnSpacing="16">
                        <Image Grid.Column="0" Source="location.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Mapa" VerticalOptions="Center" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnActionMap" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid ColumnDefinitions="22,*" Padding="46,0,20,0" HeightRequest="46" ColumnSpacing="16">
                        <Image Grid.Column="0" Source="ic_play.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Iniciar" VerticalOptions="Center" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnActionPlay" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid ColumnDefinitions="22,*" Padding="46,0,20,0" HeightRequest="46" ColumnSpacing="16">
                        <Image Grid.Column="0" Source="ic_stop.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Parar" VerticalOptions="Center" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnActionStop" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid ColumnDefinitions="22,*" Padding="46,0,20,0" HeightRequest="46" ColumnSpacing="16">
                        <Image Grid.Column="0" Source="ic_save.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Guardar" VerticalOptions="Center" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnActionSave" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid ColumnDefinitions="22,*" Padding="46,0,20,0" HeightRequest="46" ColumnSpacing="16">
                        <Image Grid.Column="0" Source="ic_trash.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Borrar" VerticalOptions="Center" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnActionClear" /></Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>

                <!-- Rutas -->
                <Grid ColumnDefinitions="26,*" Padding="20,0" HeightRequest="52" ColumnSpacing="16">
                    <Image Grid.Column="0" Source="map.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Rutas" VerticalOptions="Center" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRoutesTapped" /></Grid.GestureRecognizers>
                </Grid>

                <!-- Configuración -->
                <Grid ColumnDefinitions="26,*" Padding="20,0" HeightRequest="52" ColumnSpacing="16">
                    <Image Grid.Column="0" Source="settings.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Configuración" VerticalOptions="Center" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsTapped" /></Grid.GestureRecognizers>
                </Grid>

                <!-- Acerca de -->
                <Grid ColumnDefinitions="26,*" Padding="20,0" HeightRequest="52" ColumnSpacing="16">
                    <Image Grid.Column="0" Source="info.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Acerca de" VerticalOptions="Center" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAboutTapped" /></Grid.GestureRecognizers>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

    <!-- Estructura de navegacion (rutas). El menu visual lo pinta FlyoutContent. -->
    <FlyoutItem Title="GPS" Icon="location.png">
        <ShellContent ContentTemplate="{DataTemplate local:HomePage}" Route="HomePage" />
    </FlyoutItem>
    <FlyoutItem Title="Rutas" Icon="map.png">
        <ShellContent ContentTemplate="{DataTemplate local:RoutesPage}" Route="RoutesPage" />
    </FlyoutItem>
    <FlyoutItem Title="Configuración" Icon="settings.png">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>
    <FlyoutItem Title="Acerca de" Icon="info.png">
        <ShellContent ContentTemplate="{DataTemplate local:AboutPage}" Route="AboutPage" />
    </FlyoutItem>

</Shell>
